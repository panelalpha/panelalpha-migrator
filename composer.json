{
    "name": "wordpress-migrator/wordpress-migrator",
    "description": "WordPress Migrator Plugin",
    "type": "wordpress-plugin",
    "autoload": {
        "psr-4": {
            "WordpressMigrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WordpressMigrator\\Tests\\": "tests/"
        }
    },
    "require": {
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
