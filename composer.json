{
    "name": "panelalpha/panelalpha-migrator",
    "description": "PanelAlpha Migrator Plugin",
    "type": "wordpress-plugin",
    "autoload": {
        "psr-4": {
            "PanelAlpha\\Migrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PanelAlpha\\Migrator\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4",
        "symfony/polyfill-php80": "^1.33",
        "symfony/polyfill-mbstring": "^1.33"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
